{
  "name": "@yunlefun/ui-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "UI for Yunlefun",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run docs:build",
    "build:vue": "pnpm -C packages/vue run build",
    "dev": "npm run docs:dev",
    "docs:dev": "pnpm registry:build && vitepress dev packages",
    "docs:build": "pnpm registry:build && vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "lint": "eslint .",
    "registry:build": "shadcn-vue build registry.json -o packages/public/r",
    "registry:verify": "tsx scripts/verify-registry.ts",
    "typecheck": "vue-tsc --noEmit",
    "update": "pnpm -C packages/metadata run update && tsx scripts/update.ts",
    "prepare": "npm run update",
    "release": "npm run release:vue",
    "release:vue": "pnpm -C packages/vue run release",
    "test": "vitest"
  },
  "dependencies": {
    "@yunlefun/metadata": "workspace:*",
    "@yunlefun/ui": "workspace:*",
    "@yunlefun/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@iconify-json/logos": "^1.2.3",
    "@iconify-json/ri": "^1.2.3",
    "@nuxt/schema": "^3.14.1592",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.1",
    "@types/prettier": "^3.0.0",
    "@unocss/eslint-config": "^0.65.1",
    "@yunlefun/vue": "workspace:*",
    "bumpp": "^9.9.0",
    "consola": "^3.2.3",
    "eslint": "^9.16.0",
    "eslint-plugin-format": "^0.1.3",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.4.2",
    "sass": "^1.82.0",
    "shadcn-vue": "2.8.0",
    "simple-git": "^3.27.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "unbuild": "^2.0.0",
    "unocss": "^0.65.1",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.3",
    "vitepress": "1.5.0",
    "vitepress-plugin-group-icons": "^1.3.1",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.12"
  }
}
