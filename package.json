{
  "name": "@yunlefun/ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.6.2",
  "description": "UI for Yunlefun",
  "scripts": {
    "build": "npm run docs:build",
    "build:vue-components": "pnpm -C packages/vue-components run build",
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev packages",
    "docs:build": "vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "update": "pnpm -C packages/metadata run update && tsx scripts/update.ts",
    "postinstall": "npm run update",
    "release": "",
    "release:vue-components": "pnpm -C packages/vue-components run release",
    "test": "vitest"
  },
  "dependencies": {
    "@yunlefun/metadata": "workspace:*",
    "@yunlefun/ui": "workspace:*",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.8",
    "@iconify-json/ri": "^1.1.10",
    "@nuxt/schema": "^3.6.5",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^20.4.5",
    "@types/prettier": "^2.7.3",
    "@yunlefun/vue": "workspace:*",
    "bumpp": "^9.1.1",
    "consola": "^3.2.3",
    "eslint": "^8.45.0",
    "fast-glob": "^3.3.1",
    "fs-extra": "^11.1.1",
    "gray-matter": "^4.0.3",
    "prettier": "^3.0.0",
    "sass": "^1.64.1",
    "simple-git": "^3.19.1",
    "tsx": "^3.12.7",
    "unbuild": "^1.2.1",
    "unocss": "^0.53.6",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.7",
    "vitepress": "1.0.0-beta.6",
    "vitest": "^0.33.0",
    "vue-router": "^4.2.4",
    "vue-tsc": "^1.8.8"
  }
}
