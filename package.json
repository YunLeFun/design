{
  "name": "@yunlefun/ui-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.14.0",
  "description": "UI for Yunlefun",
  "scripts": {
    "build": "npm run docs:build",
    "build:vue": "pnpm -C packages/vue run build",
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev packages",
    "docs:build": "vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "update": "pnpm -C packages/metadata run update && tsx scripts/update.ts",
    "postinstall": "npm run update",
    "release": "npm run release:vue",
    "release:vue": "pnpm -C packages/vue run release",
    "test": "vitest"
  },
  "dependencies": {
    "@yunlefun/metadata": "workspace:*",
    "@yunlefun/ui": "workspace:*",
    "@yunlefun/vue": "workspace:*",
    "vue": "^3.4.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.6.1",
    "@iconify-json/ri": "^1.1.18",
    "@nuxt/schema": "^3.9.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.6",
    "@types/prettier": "^3.0.0",
    "@unocss/eslint-config": "^0.58.3",
    "@yunlefun/vue": "workspace:*",
    "bumpp": "^9.2.1",
    "consola": "^3.2.3",
    "eslint": "^8.56.0",
    "eslint-plugin-format": "^0.1.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.1.1",
    "sass": "^1.69.7",
    "simple-git": "^3.22.0",
    "tsx": "^4.7.0",
    "unbuild": "^2.0.0",
    "unocss": "^0.58.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.11",
    "vitepress": "1.0.0-rc.35",
    "vitest": "^1.1.3",
    "vue-tsc": "^1.8.27"
  }
}
