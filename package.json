{
  "name": "@yunlefun/design-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "description": "YunLeFun Design System",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "audit": "node scripts/audit-dependencies.mjs",
    "build": "pnpm run docs:build",
    "build:vue": "pnpm -C packages/vue run build",
    "build:ui": "pnpm -C packages/ui run build",
    "ci:publish": "node scripts/publish-packages.mjs",
    "dev": "pnpm run docs:dev",
    "docs:dev": "pnpm build:ui && pnpm build:theme && pnpm registry:build && vitepress dev packages",
    "docs:build": "pnpm build:ui && pnpm build:theme && pnpm registry:build && vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "lint": "eslint .",
    "nuxt:verify": "pnpm -C packages/vue exec nuxt build ../../test/fixtures/nuxt4",
    "registry:build": "shadcn-vue build registry.json -o packages/public/r",
    "registry:verify": "tsx scripts/verify-registry.ts",
    "ui:verify": "tsx scripts/verify-ui-package.ts",
    "vue:verify": "pnpm build:vue && tsx scripts/verify-vue-package.ts",
    "typecheck": "vue-tsc --noEmit",
    "update": "pnpm -C packages/metadata run update && tsx scripts/update.ts",
    "prepare": "pnpm run update",
    "release": "pnpm run release:vue",
    "release:vue": "pnpm -C packages/vue run release",
    "test": "vitest",
    "build:theme": "pnpm -C packages/vitepress-theme-yunlefun run build",
    "theme:verify": "node scripts/verify-theme-package.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs"
  },
  "dependencies": {
    "@yunlefun/metadata": "workspace:*",
    "@yunlefun/ui": "workspace:*",
    "@yunlefun/vue": "workspace:*",
    "vitepress-theme-yunlefun": "workspace:*",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.5",
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/ri": "^1.2.10",
    "@nuxt/schema": "^4.6.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@unocss/eslint-config": "^66.13.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vueuse/core": "^15.0.0",
    "@yunlefun/vue": "workspace:*",
    "bumpp": "^12.3.0",
    "consola": "^3.4.2",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "gray-matter": "^4.0.3",
    "happy-dom": "21.0.4",
    "oxc-parser": "0.159.0",
    "prettier": "^3.10.1",
    "reka-ui": "^2.11.0",
    "sass": "^1.108.2",
    "shadcn-vue": "2.8.2",
    "simple-git": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "unocss": "^66.13.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.8.2",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  }
}
