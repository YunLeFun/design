{
  "name": "@yunlefun/design-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "description": "YunLeFun Design System",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level low",
    "build": "pnpm run docs:build",
    "build:vue": "pnpm -C packages/vue run build",
    "build:ui": "pnpm -C packages/ui run build",
    "dev": "pnpm run docs:dev",
    "docs:dev": "pnpm registry:build && vitepress dev packages",
    "docs:build": "pnpm build:ui && pnpm registry:build && vitepress build packages",
    "docs:preview": "vitepress preview packages",
    "lint": "eslint .",
    "nuxt:verify": "pnpm -C packages/vue exec nuxt build ../../test/fixtures/nuxt4",
    "registry:build": "shadcn-vue build registry.json -o packages/public/r",
    "registry:verify": "tsx scripts/verify-registry.ts",
    "ui:verify": "tsx scripts/verify-ui-package.ts",
    "typecheck": "vue-tsc --noEmit",
    "update": "pnpm -C packages/metadata run update && tsx scripts/update.ts",
    "prepare": "pnpm run update",
    "release": "pnpm run release:vue",
    "release:vue": "pnpm -C packages/vue run release",
    "test": "vitest"
  },
  "dependencies": {
    "@yunlefun/metadata": "workspace:*",
    "@yunlefun/ui": "workspace:*",
    "@yunlefun/vue": "workspace:*",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ri": "^1.2.10",
    "@nuxt/schema": "^4.5.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "@unocss/eslint-config": "^66.7.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vueuse/core": "^14.3.0",
    "@yunlefun/vue": "workspace:*",
    "bumpp": "^11.1.0",
    "consola": "^3.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.6",
    "gray-matter": "^4.0.3",
    "happy-dom": "20.11.2",
    "oxc-parser": "0.143.0",
    "prettier": "^3.9.5",
    "reka-ui": "^2.10.1",
    "sass": "^1.101.0",
    "shadcn-vue": "2.8.2",
    "simple-git": "^3.36.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "unbuild": "^3.6.1",
    "unocss": "^66.7.5",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
