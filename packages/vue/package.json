{
  "name": "@yunlefun/vue",
  "type": "module",
  "version": "0.5.0",
  "description": "Vue components and Nuxt integration for YunLeFun Design",
  "author": "YunLeFun",
  "license": "MIT",
  "homepage": "https://ui.yunle.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/design.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/YunLeFun/design/issues"
  },
  "exports": {
    "./components/*.vue": {
      "types": "./dist/components/*.vue.d.ts",
      "default": "./components/*.vue"
    },
    "./components/*": "./components/*",
    "./nuxt": "./nuxt.mjs",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*",
    "./ai-prompt": {
      "types": "./dist/ai-prompt.d.ts",
      "import": "./dist/ai-prompt.mjs",
      "require": "./dist/ai-prompt.cjs"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui.d.ts",
      "import": "./dist/ag-ui.mjs",
      "require": "./dist/ag-ui.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "components",
    "dist",
    "nuxt.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && vue-tsc --project tsconfig.build.json && unbuild",
    "prepublishOnly": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@ag-ui/client": "^1.0.1",
    "nuxt": "^4.0.0",
    "sass": "^1.101.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    }
  },
  "dependencies": {
    "@yunlefun/icons": "^0.3.1",
    "reka-ui": "^2.10.1"
  },
  "devDependencies": {
    "nuxt": "^4.5.2",
    "sass": "^1.101.0",
    "typescript": "5.9.3"
  }
}
