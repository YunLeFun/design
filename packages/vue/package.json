{
  "name": "@yunlefun/vue",
  "type": "module",
  "version": "0.1.2",
  "description": "Vue components and Nuxt integration for YunLeFun Design",
  "author": "YunLeFun",
  "license": "MIT",
  "homepage": "https://ui.yunle.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/design.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/YunLeFun/design/issues"
  },
  "exports": {
    "./components/*": "./components/*",
    "./nuxt": "./nuxt.mjs",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "components",
    "dist",
    "nuxt.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "sass": "^1.101.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "dependencies": {
    "reka-ui": "^2.10.1"
  },
  "devDependencies": {
    "nuxt": "^4.5.2",
    "sass": "^1.101.0",
    "typescript": "5.9.3"
  }
}
