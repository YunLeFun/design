{
  "name": "@yunlefun/ui",
  "version": "0.0.7",
  "description": "Shared styles and design tokens for YunLeFun Design",
  "author": "YunLeFun",
  "license": "MIT",
  "homepage": "https://design.yunle.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/design.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/YunLeFun/design/issues"
  },
  "keywords": [
    "ui",
    "css"
  ],
  "exports": {
    "./css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/index.css"
    },
    "./tokens.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./compat.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/compat.css"
    },
    "./fonts.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/fonts.css"
    },
    "./patterns.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/patterns.css"
    },
    "./admin.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/admin.css"
    },
    "./editor.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/editor.css"
    },
    "./adapters/shadcn.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/adapters/shadcn.css"
    },
    "./adapters/nuxt-ui.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/adapters/nuxt-ui.css"
    },
    "./adapters/tdesign.css": {
      "types": "./styles/css.d.ts",
      "default": "./dist/adapters/tdesign.css"
    },
    "./tokens.json": "./dist/tokens.json",
    "./tokens": {
      "types": "./tokens/index.d.ts",
      "default": "./tokens/index.mjs"
    },
    "./unocss": {
      "types": "./unocss.d.ts",
      "default": "./unocss.mjs"
    },
    "./styles": "./styles/index.scss",
    "./styles/*": "./styles/*",
    "./*": "./*"
  },
  "files": [
    "dist",
    "styles",
    "tokens",
    "unocss.d.ts",
    "unocss.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish"
  },
  "peerDependencies": {
    "sass": "^1.101.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "sass": "^1.108.2"
  }
}
