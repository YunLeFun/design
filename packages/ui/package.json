{
  "name": "@yunlefun/ui",
  "version": "0.0.3",
  "description": "Shared styles and design tokens for YunLeFun Design",
  "author": "YunLeFun",
  "license": "MIT",
  "homepage": "https://ui.yunle.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/design.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/YunLeFun/design/issues"
  },
  "keywords": [
    "ui",
    "css"
  ],
  "exports": {
    "./css": "./dist/index.css",
    "./patterns.css": "./dist/patterns.css",
    "./styles": "./styles/index.scss",
    "./styles/*": "./styles/*",
    "./*": "./*"
  },
  "files": [
    "dist",
    "styles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sass styles/index.scss dist/index.css --no-source-map --style=compressed && sass styles/patterns.scss dist/patterns.css --no-source-map --style=compressed",
    "prepack": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish"
  },
  "peerDependencies": {
    "sass": "^1.101.0"
  },
  "peerDependenciesMeta": {
    "sass": {
      "optional": true
    }
  },
  "devDependencies": {
    "sass": "^1.101.0"
  }
}
