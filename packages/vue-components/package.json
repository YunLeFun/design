{
  "name": "@yunlefun/vue-components",
  "type": "module",
  "version": "0.0.5-beta.4",
  "description": "Components for YunLeFun",
  "exports": {
    "./auto-import-resolver": {
      "types": "./dist/auto-import-resolver.d.ts",
      "require": "./dist/auto-import-resolver.cjs",
      "import": "./dist/auto-import-resolver.mjs"
    },
    "./components/*": "./dist/runtime/components/*",
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "auto-import-resolver.d.ts"
  ],
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "unplugin-vue-components": "^0.25.1"
  }
}
