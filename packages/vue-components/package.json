{
  "name": "@yunlefun/vue-components",
  "type": "module",
  "version": "0.0.4-beta.4",
  "description": "Components for YunLeFun",
  "exports": {
    "./auto-import-resolver": {
      "types": "./dist/auto-import-resolver.d.ts",
      "require": "./dist/auto-import-resolver.cjs",
      "import": "./dist/auto-import-resolver.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.cjs",
      "import": "./dist/types.mjs"
    },
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    },
    "./*": "./*"
  },
  "main": "./dist/index.cjs",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "types.d.ts"
  ],
  "scripts": {
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "release": "bumpp --no-commit --no-tag --no-push && npm publish"
  },
  "devDependencies": {
    "unplugin-vue-components": "^0.25.1"
  }
}
